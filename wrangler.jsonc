{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rethox",
  "compatibility_date": "2026-07-13",
  "main": "./apps/web/src/worker.ts",
  "workers_dev": true,
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
