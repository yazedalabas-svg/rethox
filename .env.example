# Supabase Project Settings > API
# This publishable key is safe to expose in the browser. Never put a secret or
# service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-side aliases used by the API. These can be the same public values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Google OAuth 2.0 (server-side authorization-code flow). Create a web client
# in Google Cloud Console and register the redirect URI:
#   <PUBLIC_SITE_URL>/api/auth/google/callback
# The secret must never be exposed to the browser.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional local-only high quality narrator. Do not use a VITE_ prefix and do
# not put this key in Render. Enable the Cloud Text-to-Speech API first.
TTS_PROVIDER=google-cloud
GOOGLE_TTS_API_KEY=your-local-google-cloud-api-key
GOOGLE_TTS_VOICE=ar-XA-Chirp3-HD-Aoede

# Moyasar payments. The secret key is backend-only and must never carry a
# VITE_ prefix. Use sk_test_ while testing and swap to sk_live_ to take real
# money. MOYASR_WEBHOOK_SECRET must match the "secret token" you set on the
# webhook endpoint in the Moyasar dashboard, otherwise webhooks are rejected.
MOYASR_SECRET_KEY=sk_test_your-key
MOYASR_WEBHOOK_SECRET=a-long-random-string-you-also-paste-into-moyasar
MOYASR_BASE_URL=https://api.moyasar.com/v1

# Set to "demo" only for local work without a payment gateway. Any other value
# (including unset) requires a real verified payment before books are unlocked.
PAYMENTS_MODE=

# Required by the app's short-lived API sessions.
JWT_SECRET=replace-with-a-long-random-secret

# App server and optional integrations
PORT=4181
WEB_ORIGIN=http://127.0.0.1:5173
PUBLIC_SITE_URL=http://127.0.0.1:5173
DATABASE_URL=postgresql://rethox:rethox@localhost:5432/rethox
SUMMARY_API_URL=
SUMMARY_API_KEY=
SUMMARY_MODEL=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
